# Local Development Environment Configuration (Windows)
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    PowerShell: Copy-Item .env.local.example .env.local
#    Or manually copy and rename in File Explorer
#
# 2. Edit .env.local with your preferred editor (VS Code, Notepad, etc.)
#
# 3. Make sure Docker services are running first:
#    From root: .\start-dev.ps1

# ============================================
# REDIS CONFIGURATION (Local Docker)
# ============================================
# Change from: REDIS_HOST=192.168.125.242
# To use local Docker Redis:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# KAFKA CONFIGURATION (Local Docker)
# ============================================
# Change from: KAFKA_BROKERS=192.168.125.242:9093
# To use local Docker Kafka (note: port changed from 9093 to 9092):
KAFKA_BROKERS=localhost:9092

# ============================================
# DATABASE CONFIGURATION (Remote AWS)
# ============================================
# Keep your existing AWS database configuration from .env
# Do NOT change these - they point to remote AWS database
# DATABASE_HOST=siliconfort-restapi-db.cdkdgwujhnpt.ap-southeast-1.rds.amazonaws.com
# DATABASE_PORT=1433
# DATABASE_USERNAME=siliconfortmaster
# DATABASE_PASSWORD=PCrG2kx8lkYqN5Q
# DATABASE_NAME=siliconfort_staging

# ============================================
# WINDOWS SETUP NOTES
# ============================================
# 1. Start Docker services first: 
#    PowerShell: cd c:\10-Projects\sf
#                .\start-dev.ps1
#
# 2. Then run crm-rest-api manually:
#    PowerShell: cd c:\10-Projects\sf\crm-rest-api
#                npm run start:dev
#
# 3. Docker services will be available at:
#    - Redis: localhost:6379
#    - Kafka: localhost:9092
#
# 4. All other configuration should remain the same as your .env file
# 5. This file (.env.local) is for local development only
