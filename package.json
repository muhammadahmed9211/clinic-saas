{
  "name": "siliconfort-rest-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typeorm": "env-cmd ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:revert",
    "schema:drop": "npm run typeorm -- --dataSource=src/database/data-source.ts schema:drop",
    "seed:create": "hygen seeds create",
    "seed:run": "ts-node -r tsconfig-paths/register ./src/database/seeds/run-seed.ts",
    "cleanup:db": "env-cmd ts-node -r tsconfig-paths/register ./scripts/cleanup-database.ts",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:swc": "nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "env-cmd jest --config ./test/jest-e2e.json",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.462.0",
    "@elastic/elasticsearch": "^8.15.1",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/bull": "^10.2.0",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "10.2.10",
    "@nestjs/config": "3.1.1",
    "@nestjs/core": "10.2.10",
    "@nestjs/elasticsearch": "^10.0.2",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^10.3.2",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "^10.2.10",
    "@nestjs/platform-socket.io": "^10.4.5",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "7.1.16",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "10.0.1",
    "@nestjs/websockets": "^10.4.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/ioredis": "^4.28.10",
    "@types/multer-s3": "3.0.3",
    "apple-signin-auth": "1.7.5",
    "aws-sdk": "^2.1555.0",
    "axios": "^1.6.7",
    "bcryptjs": "2.4.3",
    "binance": "^2.10.2",
    "bull": "^4.16.0",
    "cache-manager": "^5.6.1",
    "cache-manager-ioredis-yet": "^2.1.2",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "crypto": "^1.0.1",
    "csv-parse": "^5.5.6",
    "csv-parser": "^3.0.0",
    "date-fns": "^4.1.0",
    "elastic-apm-node": "^4.6.0",
    "exceljs": "^4.4.0",
    "fb": "2.0.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "9.4.1",
    "handlebars": "4.7.8",
