    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.2.1",
    "@nestjs/schematics": "10.0.3",
    "@nestjs/testing": "10.2.10",
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.3.100",
    "@types/bcryptjs": "2.4.6",
    "@types/bull": "^4.10.0",
    "@types/express": "4.17.21",
    "@types/facebook-js-sdk": "3.3.10",
    "@types/jest": "29.5.10",
    "@types/json2csv": "^5.0.7",
    "@types/ms": "0.7.34",
    "@types/multer": "1.4.11",
    "@types/node": "20.10.1",
    "@types/otp-generator": "^4.0.2",
    "@types/passport-anonymous": "1.0.5",
    "@types/passport-jwt": "3.0.13",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "2.0.16",
    "@types/twitter": "1.7.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "6.13.1",
    "@typescript-eslint/parser": "6.13.1",
    "env-cmd": "10.1.0",
    "eslint": "8.54.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prettier": "5.0.1",
    "husky": "8.0.3",
    "hygen": "6.2.11",
    "is-ci": "3.0.1",
    "jest": "29.7.0",
    "prettier": "3.1.0",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.6.2",
    "typescript": "5.3.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
