    "kafkajs": "^2.2.4",
    "moment-timezone": "^0.5.46",
    "ms": "2.1.3",
    "mssql": "^9.3.0",
    "multer": "^1.4.4",
    "multer-s3": "3.0.1",
    "nestjs-i18n": "10.4.0",
    "nestjs-redis": "^1.3.3",
    "nestjs-twilio": "^4.2.0",
    "nodemailer": "6.9.7",
    "otp-generator": "^4.0.1",
    "passport": "0.7.0",
    "passport-anonymous": "1.0.1",
    "passport-jwt": "4.0.1",
    "qrcode": "^1.5.3",
    "redis": "^4.6.14",
    "reflect-metadata": "0.1.13",
    "rimraf": "5.0.5",
    "rxjs": "7.8.1",
    "socket.io": "^4.8.1",
